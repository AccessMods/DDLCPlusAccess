<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Doki Doki Literature Club Plus</GamePath>
    <GamePath Condition="!Exists('$(GamePath)') And Exists('S:\steam\steamapps\common\Doki Doki Literature Club Plus')">S:\steam\steamapps\common\Doki Doki Literature Club Plus</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="MelonLoader">
      <HintPath>$(GamePath)\MelonLoader\net6\MelonLoader.dll</HintPath>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GamePath)\MelonLoader\net6\0Harmony.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="DDLC">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\DDLC.dll</HintPath>
    </Reference>
    <Reference Include="TMPro">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
    </Reference>
    <Reference Include="SimpleExpressionEngine">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\SimpleExpressionEngine.dll</HintPath>
    </Reference>
    <Reference Include="UnityPS">
      <HintPath>$(GamePath)\Doki Doki Literature Club Plus_Data\Managed\UnityPS.dll</HintPath>
    </Reference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityAccessibilityLib" Version="2.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Offline data-extraction tools are separate programs, not part of the mod -->
    <Compile Remove="tools\**" />
    <None Remove="tools\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Localized mod strings, one file per game language: Loc.en-us.txt, Loc.spa.txt, ... -->
    <EmbeddedResource Include="Localization\*.txt" LogicalName="Loc.%(Filename)%(Extension)" />
    <!-- Which script lines / images trigger which scene description -->
    <EmbeddedResource Include="SceneDescriptions\SceneEvents.txt" LogicalName="SceneEvents.txt" />
    <EmbeddedResource Include="SceneDescriptions\SceneRules.txt" LogicalName="SceneRules.txt" />
  </ItemGroup>
  <Target Name="CopyModAfterBuild" AfterTargets="Build">
    <!-- Display a message in the build output -->
    <Message Text="--- Copying $(ProjectName).dll to game folder ---" Importance="high" />
    <!-- Copy the mod DLL -->
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GamePath)\Mods\" />
    <!-- Copy UnityAccessibilityLib.dll -->
    <Message Text="--- Copying UnityAccessibilityLib.dll to game folder ---" Importance="high" />
    <Copy SourceFiles="$(TargetDir)UnityAccessibilityLib.dll" DestinationFolder="$(GamePath)\" />
    <!-- Prism (speech output) and its licences, loaded by full path from Mods\DDLCPlusAccess -->
    <Message Text="--- Copying Prism to game folder ---" Importance="high" />
    <ItemGroup>
      <PrismLicenses Include="lib\prism\third-party\**\*" />
    </ItemGroup>
    <Copy SourceFiles="lib\prism\prism.dll" DestinationFolder="$(GamePath)\Mods\DDLCPlusAccess\" />
    <Copy SourceFiles="@(PrismLicenses)" DestinationFiles="@(PrismLicenses->'$(GamePath)\Mods\DDLCPlusAccess\third-party\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
