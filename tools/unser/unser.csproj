<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Decodes a Unity MonoBehaviour blob (no type tree) to JSON, deriving the serialized layout
    from the game's assemblies with Mono.Cecil. See tools/README.md.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GamePath Condition="'$(GamePath)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Doki Doki Literature Club Plus</GamePath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Mono.Cecil">
      <HintPath>$(GamePath)\MelonLoader\net6\Mono.Cecil.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
